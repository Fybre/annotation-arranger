# Copy this file to .env beside the executable, or in the source project folder.
# Replace these placeholders with your Therefore server/tenant.
THEREFORE_BASE_URL=https://your-tenant.thereforeonline.com/theservice/v0001/restun
THEREFORE_TENANT=your-tenant
HOST=127.0.0.1
PORT=8765
PROCESSING_TIMEOUT_SECONDS=120
# Backups are off by default. Set true to save original PDFs locally before updating.
BACKUP_ENABLED=false
DEBUG_LOGGING=false
# Relative paths are resolved beside .env. Only used when backups are enabled.
BACKUP_DIR=var/backups
